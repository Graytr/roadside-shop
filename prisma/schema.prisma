generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inventory {
  // one row per product per guild
  guildId String
  name    String
  price   Float
  stock   Int

  @@id([guildId, name])
  @@map("inventory")
}

model Material {
  guildId String
  name    String
  value   Float

  @@id([guildId, name])
  @@map("materials")
}

model Wallet {
  guildId String
  userId  String
  // store cents to avoid float rounding; services can convert if you prefer
  cents   Int

  @@id([guildId, userId])
  @@map("wallets")
}

model Bem {
  guildId String
  id      String   // e.g., "BEM-001"
  label   String
  qty     Int

  @@id([guildId, id])
  @@map("bems")
}

model BemCustody {
  guildId String
  bemId   String
  userId  String
  qty     Int
  ts      BigInt   // epoch ms

  @@id([guildId, bemId, userId])
  @@map("bem_custody")
}
