// prisma/schema.prisma
generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite"; url = env("DATABASE_URL") }

/** Catalog of items your bot tracks (e.g., Carrot Pie). */
model Item {
  guildId String
  name    String   // unique per guild
  price   Float?   // optional, keep/remove as you like
  @@id([guildId, name])
  @@map("items")
}

/** All guild-owned holdings, physically held by users (no central pool). */
model ItemCustody {
  guildId String
  item    String
  userId  String
  qty     Int      // integer; cannot be fractional
  ts      BigInt   // last change timestamp (ms)
  @@id([guildId, item, userId])
  @@map("item_custody")
}

/** Optional: production audit (who crafted what for the guild). */
model ProductionLog {
  id      String  @id @default(cuid())
  guildId String
  item    String
  userId  String
  qty     Int
  ts      BigInt
  note    String?
  @@index([guildId, item, userId, ts])
  @@map("production_log")
}

/** Optional: transfer audit between members (hand-offs). */
model TransferLog {
  id       String  @id @default(cuid())
  guildId  String
  item     String
  fromUser String
  toUser   String
  qty      Int
  ts       BigInt
  note     String?
  @@index([guildId, item, fromUser, toUser, ts])
  @@map("transfer_log")
}

/** Optional: consumption/sale/removal audit. */
model ConsumptionLog {
  id      String  @id @default(cuid())
  guildId String
  item    String
  userId  String    // who reduced their held qty
  qty     Int       // positive; means “qty removed”
  reason  String?
  ts      BigInt
  @@index([guildId, item, userId, ts])
  @@map("consumption_log")
}

/** BEM catalog and per-user custody (same discrete-unit idea). */
model Bem {
  guildId String
  id      String
  label   String
  qty     Int       // total number the guild manages
  @@id([guildId, id])
  @@map("bems")
}

model BemCustody {
  guildId String
  bemId   String
  userId  String
  qty     Int
  ts      BigInt
  @@id([guildId, bemId, userId])
  @@map("bem_custody")
}

/** Materials setting knob (unchanged). */
model Material {
  guildId String
  name    String
  value   Float
  @@id([guildId, name])
  @@map("materials")
}
